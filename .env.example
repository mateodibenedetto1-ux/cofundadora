# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor. Nunca la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL pública de la app (para invitaciones y webhooks)
NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app

# --- Claude del equipo: genera los roadmaps y responde en el panel de Val ---
# Cada fundadora usa su propia key dentro de su portal (se guarda cifrada).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5


# Cifra las API keys de las fundadoras. Una frase larga al azar.
AI_KEYS_SECRET=

# Kajabi: webhook de compra que crea el portal y manda la invitación
KAJABI_WEBHOOK_SECRET=
# Opcional: solo compras cuya oferta contenga este texto (ej. MAGNA)
KAJABI_OFFER_MATCH=

# Dropbox: sincroniza clases y guías para Visionaria (app en dropbox.com/developers)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
